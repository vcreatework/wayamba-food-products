---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page not found">
  <section style="padding:200px 0 140px;text-align:center">
    <div class="container">
      <h1>Lost in the spice market?</h1>
      <p class="lead" style="margin:20px auto 30px">That page doesn't exist. Try our spice catalogue instead.</p>
      <a class="btn btn-lg" href={u('/spices/')}>Browse spices</a>
    </div>
  </section>
</Base>
